<Layouts.app flash={@flash}>
  <div class="land">
    <nav class="lnav">
      <a class="brand" href="/">
        <img
          src={~p"/images/logo-long.png"}
          alt="AperDesk"
          height="26"
          style="height:26px;width:auto"
        />
      </a>
      <a class="nl" href="#features">Features</a>
      <a class="nl" href="#flow">How it works</a>
      <a class="nl" href="#roles">Roles</a>
      <a class="nl" href="#pricing">Pricing</a>
      <a class="nl" href="#faq">FAQ</a>
      <span class="spacer"></span>
      <button
        class="theme-btn"
        phx-click={JS.dispatch("phx:set-theme")}
        data-phx-theme="dark"
        aria-label="Switch to dark theme"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <span>Theme</span>
      </button>
      <a class="nl" href="/sign-in">Sign in</a>
      <a class="btn primary" href="/sign-up">Start free trial</a>
    </nav>

    <div class="hero">
      <div>
        <span class="eyebrow">The studio system for photographers</span>
        <h1 style="margin-top:14px">
          Every inquiry answered, every date <em>protected</em>, every gallery delivered.
        </h1>
        <p class="lead">
          Forward an inquiry email and it becomes a lead with a drafted reply. Send a package,
          get the contract signed, shoot the day, deliver a branded gallery, and pay the crew.
          One place, five roles, no spreadsheet.
        </p>
        <div class="cta">
          <a class="btn primary" href="/sign-up">Start your free trial</a>
          <a class="btn" href="#pricing">See pricing</a>
        </div>
        <div class="fine">30-day free trial · No credit card · Set up in about two minutes</div>
      </div>
      <div class="hero-art">
        <div class="photo p1 ph"></div>
        <div class="photo p2 ph"></div>
        <div class="photo p3 ph"></div>
        <div class="float">
          <b>Lena &amp; Marco · Wedding</b>
          <div class="row">
            <span>Arrived by email · 09:12</span>
            <span class="pill new" style="padding:0 7px">lead created</span>
          </div>
          <div class="row">
            <span>Sat 14 Jun 2027</span>
            <span class="pill ok" style="padding:0 7px">date free</span>
          </div>
          <div class="row"><span>Reply</span><span>drafted · waiting for you</span></div>
        </div>
      </div>
    </div>

    <div class="tstat">
      <div class="quote-hero">
        <p>
          "I went from four tools and a spreadsheet to one place. My reply time dropped to under
          an hour, and couples notice. The clash check alone has saved two Saturdays this year."
        </p>
        <div class="who">
          <div class="photo ph"></div>
          <span><b>Aria Mehta</b>Owner, Aperture &amp; Co · Lisbon</span>
        </div>
      </div>
      <div class="nums">
        <div><b>2 min</b><span>Average setup time</span></div>
        <div><b>30 days</b><span>Free trial, no card</span></div>
        <div><b>4h</b><span>Reply target on every lead</span></div>
        <div><b>1 tool</b><span>Replaces CRM, calendar, gallery, invoicing</span></div>
      </div>
    </div>

    <div class="sec" id="features">
      <div class="head">
        <h2>Built for how a studio actually runs.</h2>
        <p>
          Thirteen pieces that fit together. Each one is simple on its own. Together they carry
          a booking from the first email to the final download.
        </p>
      </div>
      <div class="fgrid">
        <div class="fc hero">
          <div class="ft">
            <i>
              <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
              </svg>
            </i>
            <span class="ph-tag">Capture</span>
            <h3>Email lead capture</h3>
            <p>
              Forward an inquiry. We read the name, date and request, create the lead, check the
              calendar and draft the reply. You review and send.
            </p>
          </div>
          <div class="demo">
            <div class="mail">
              <span class="from">lena.h@gmail.com</span>
              <span class="subj">Wedding photography · 14 June 2027 · Sintra</span>
              <span class="body">
                Hi! We're getting married at Palácio de Monserrate next June, around 120 guests.
                Are you free, and what would a full day cost?
              </span>
            </div>
            <div class="arrow">→</div>
            <div class="lead">
              <span class="k">Lead created · 09:12</span>
              <span class="v"><b>Lena Huber &amp; Marco Rossi</b> · Wedding</span>
              <span class="v">
                <span class="mono">14 Jun 2027</span>
                · <span class="pill ok" style="padding:0 7px">date free</span>
              </span>
              <span class="v">Package: Full day · $7,200</span>
              <span class="v">
                <span class="pill new" style="padding:0 7px">reply drafted</span> waiting for you
              </span>
            </div>
          </div>
        </div>

        <div :for={feature <- features()} class="fc">
          <i>{Phoenix.HTML.raw(feature.icon)}</i>
          <span class="ph-tag">{feature.phase}</span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </div>
      </div>
    </div>

    <div class="sec" id="flow">
      <div class="head">
        <h2>From inquiry to delivery, in four phases.</h2>
        <p>
          Each phase is one screen and a handful of automatic steps. Nothing goes to a client
          until you have seen it, unless you decide it should.
        </p>
      </div>
      <div class="phases">
        <div
          :for={{phase, index} <- Enum.with_index(phases())}
          class={["phase", rem(index, 2) == 1 && "alt"]}
        >
          <div class="ptext">
            <span class="pn">{phase.number} · {phase.name}</span>
            <h3>{phase.title}</h3>
            <p>{phase.body}</p>
            <ul>
              <li :for={point <- phase.points}><span class="dot"></span>{point}</li>
            </ul>
          </div>
          <div class="photo ph"></div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:6px;margin-top:28px">
        <a class="btn primary" href="/sign-up">Try the whole flow free</a>
        <span class="fine" style="font-size:12px;color:var(--faint)">
          30 days, no credit card
        </span>
      </div>
    </div>

    <div class="sec" id="roles">
      <div class="head">
        <h2>One studio, five seats at the table.</h2>
        <p>
          Each role signs in to the view they need. The owner sees everything. Everyone else sees
          their work, and nothing they should not.
        </p>
      </div>
      <div class="roles">
        <div :for={role <- roles()} class="role">
          <span class="eyebrow">{role.name}</span>
          <h3>{role.title}</h3>
          <p>{role.body}</p>
        </div>
      </div>
    </div>

    <div class="sec" id="pricing">
      <div class="pricing-head">
        <div>
          <h2>Simple, predictable pricing.</h2>
          <p style="color:var(--muted);margin:6px 0 0">
            Pick the plan that fits today and move up when you are ready. Thirty days free on
            every plan.
          </p>
        </div>
        <span class="spacer"></span>
        <div class="seg">
          <button
            :for={{value, label} <- [{"monthly", "Monthly"}, {"yearly", yearly_label(@plans)}]}
            aria-pressed={to_string(@period == String.to_existing_atom(value))}
            phx-click="set-period"
            phx-value-period={value}
          >
            {label}
          </button>
        </div>
        <div class="seg">
          <button
            :for={code <- @currencies}
            aria-pressed={to_string(@currency == code)}
            phx-click="set-currency"
            phx-value-currency={code}
          >
            {code}
          </button>
        </div>
      </div>

      <div class="plans">
        <div :for={plan <- @plans} class={["plan", highlighted?(plan) && "hi"]}>
          <span class="eyebrow">
            {plan.name}{if highlighted?(plan), do: " · most popular"}
          </span>
          <div class="price">
            <span>{price(plan, @period, @currency)}</span><small> / month</small>
          </div>
          <p class="pfor">{plan.tagline}</p>
          <ul>
            <li :for={bullet <- plan_bullets(plan)}>{bullet}</li>
            <li :if={extra_seat_price(plan, @currency)}>
              Extra users at {extra_seat_price(plan, @currency)} each
            </li>
          </ul>
          <a class={["btn", highlighted?(plan) && "primary"]} href="/sign-up">Start free trial</a>
        </div>
      </div>

      <div class="addons">
        <div>
          <b>Storage block</b>
          <span>
            $5 per month for 50 GB more. Stack as many as you need and cancel any block at the
            end of its period.
          </span>
        </div>
        <div>
          <b>Gallery extension</b>
          <span>
            Keep one gallery live longer: $5 for 30 days, $9 for 60, $12 for 90. One-time charge.
          </span>
        </div>
        <div>
          <b>How storage works</b>
          <span>
            Caps apply to live galleries only. When a gallery reaches the end of its window it
            archives and the space frees up. You have 30 days to bring it back.
          </span>
        </div>
      </div>

      <div class="incl">
        <span class="eyebrow">Every plan includes</span>
        <div>
          <span :for={item <- included()}>✓ {item}</span>
        </div>
      </div>
    </div>

    <div class="sec">
      <div class="head">
        <h2>Plus the small things photographers keep asking for.</h2>
        <p>
          The details that make a tool feel built for you rather than adapted from someone else's
          software.
        </p>
      </div>
      <div class="small">
        <div :for={item <- extras()}>
          <b>{item.title}</b><span>{item.body}</span>
        </div>
      </div>
    </div>

    <div class="sec" id="beliefs">
      <div class="head">
        <h2>What we believe.</h2>
        <p>A short list, so you can hold us to it.</p>
      </div>
      <div class="beliefs">
        <div :for={belief <- beliefs()}>
          <h3>{belief.title}</h3>
          <p>{belief.body}</p>
        </div>
      </div>
    </div>

    <div class="sec" id="faq">
      <div class="head">
        <h2>Frequently asked questions.</h2>
        <p>
          Still wondering about something?
          <a
            class="link"
            href="mailto:support@aperdesk.com"
            style="color:var(--accent-text);font-weight:600"
          >
            Email us
          </a>
          and a real person replies.
        </p>
      </div>
      <div class="faq">
        <details :for={{item, index} <- Enum.with_index(faqs())} open={index == 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      </div>
    </div>

    <div class="ctaband">
      <div>
        <h2>Spend less time managing, more time shooting.</h2>
        <p>
          Try AperDesk free for 30 days. No credit card. Import your leads today and book your
          first clash-free Saturday tomorrow.
        </p>
        <div style="margin-top:18px;display:flex;gap:8px;flex-wrap:wrap">
          <a class="btn primary" href="/sign-up">Start your free trial</a>
          <a
            class="btn"
            href="mailto:support@aperdesk.com"
            style="background:transparent;color:inherit;border-color:color-mix(in srgb,var(--bg) 40%,transparent)"
          >
            Talk to us
          </a>
        </div>
      </div>
      <div class="photo ph"></div>
    </div>

    <footer class="lfoot">
      <div>
        <span class="brand">
          <img src={~p"/images/logo-long.png"} alt="AperDesk" style="height:24px;width:auto" />
        </span>
        <p style="margin:8px 0 0;max-width:34ch">
          The studio system photographers actually want to use. Capture leads, run shoots,
          deliver galleries, pay the crew.
        </p>
        <p style="margin:8px 0 0">
          Questions?
          <a class="link" style="color:var(--accent-text)" href="mailto:support@aperdesk.com">
            support@aperdesk.com
          </a>
        </p>
      </div>
      <div>
        <h4>Product</h4>
        <a href="#features">Features</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a href="/sign-up">Free trial</a>
      </div>
      <div>
        <h4>For clients</h4>
        <a href="/find">Find a photographer</a>
        <a href="/book">Book a session</a>
        <a href="/inquire">Inquiry form</a>
      </div>
      <div>
        <h4>Company</h4>
        <a href="#beliefs">About</a>
        <a href="#">Terms</a>
        <a href="#">Privacy</a>
      </div>
    </footer>
  </div>
</Layouts.app>
