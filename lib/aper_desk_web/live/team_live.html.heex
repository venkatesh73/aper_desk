<Layouts.app flash={@flash}>
  <div class="app">
    <.sidebar current_scope={@current_scope} active={:team} />

    <div class="main">
      <.topbar
        title="Team"
        subtitle={"#{staff_count(@members)} on staff · #{freelance_count(@members)} freelance"}
      >
        <:actions>
          <span :if={@invitations != []} class="pill warn">
            {length(@invitations)} invited
          </span>
        </:actions>
      </.topbar>

      <div class="seg" style="margin-bottom:14px">
        <button
          :for={{key, label} <- tabs(@current_scope)}
          aria-pressed={to_string(@tab == key)}
          phx-click="tab"
          phx-value-tab={key}
        >
          {label}
          <span :if={key == "leave" and @tab != "leave" and pending_count(@leave) > 0} class="n">
            {pending_count(@leave)}
          </span>
        </button>
      </div>

      <div :if={@invite_token} class="panel" style="margin-bottom:12px">
        <div class="ph-head">
          <h3>The link for {@invited_email}</h3>
        </div>
        <div class="sharebox">
          <input value={invite_url(@invite_token)} readonly id="invite-url" />
          <button
            class="btn sm"
            type="button"
            id="copy-invite"
            phx-hook="CopyLink"
            data-copy-from="invite-url"
          >
            Copy
          </button>
        </div>
        <span class="help" style="font-size:12px;color:var(--faint)">
          Send it to them yourself. Only a hash is stored, so it cannot be shown again.
        </span>
      </div>

      <div :if={@tab == "people"} class="split">
        <div>
          <div :if={@members != []} class="team" style="grid-template-columns:repeat(2,1fr)">
            <div :for={member <- @members} class="member">
              <span
                class="av"
                style="width:52px;height:52px;border-radius:50%;flex:none;display:grid;place-items:center;font-size:15px"
              >
                {initials(member)}
              </span>

              <div style="min-width:0;flex:1">
                <%= if @editing == member.id do %>
                  <.form
                    for={@member_form}
                    phx-change="validate-member"
                    phx-submit="save-member"
                    class="form"
                    style="gap:10px"
                  >
                    <b>{member_name(member)}</b>

                    <%= if changeable?(member, @owners) do %>
                      <.select_field
                        field={@member_form[:role]}
                        label="Role"
                        options={role_options()}
                        hint={role_detail(@member_form[:role].value || member.role)}
                      />
                    <% else %>
                      <.field
                        label="Role"
                        hint="A studio has to keep one owner, so this one cannot change. Make somebody else an owner first."
                      >
                        <input type="hidden" name="membership[role]" value={member.role} />
                        <input type="text" value={role_label(member.role)} disabled />
                      </.field>
                    <% end %>
                    <.row layout="two">
                      <.select_field
                        field={@member_form[:employment_type]}
                        label="Engagement"
                        options={employment_options()}
                      />
                      <.field label={"Day rate (#{@current_scope.currency})"}>
                        <input
                          type="text"
                          inputmode="decimal"
                          name="membership[day_rate_major]"
                          value={@day_rate_major}
                          placeholder="Leave blank for salaried"
                        />
                      </.field>
                    </.row>
                    <.text_field
                      field={@member_form[:contract_ends_on]}
                      label="Contract ends"
                      type="date"
                    />

                    <.form_actions>
                      <button type="submit" class="btn primary btn-sm">Save</button>
                      <button type="button" class="btn ghost" phx-click="cancel-edit">
                        Cancel
                      </button>
                      <span class="spacer"></span>
                      <button
                        :if={changeable?(member, @owners)}
                        type="button"
                        class="btn ghost"
                        phx-click="remove"
                        phx-value-id={member.id}
                        data-confirm={"Remove #{member_name(member)} from the studio?"}
                      >
                        Remove
                      </button>
                    </.form_actions>
                  </.form>
                <% else %>
                  <b>{member_name(member)}</b>
                  <span class="r">{member_line(member)}</span>
                  <span class="r" style="display:block">{member_email(member)}</span>

                  <div class="tags">
                    <span class={["pill", status_tone(member.status)]}>
                      {String.capitalize(member.status)}
                    </span>
                    <span
                      :if={contract_note(@current_scope, member)}
                      class={[
                        "pill",
                        elem(contract_note(@current_scope, member), 0)
                      ]}
                    >
                      {elem(contract_note(@current_scope, member), 1)}
                    </span>
                    <span class="pill">{last_seen(@current_scope, member)}</span>
                  </div>

                  <div style="margin-top:8px;display:flex;gap:6px;align-items:center">
                    <button class="btn sm" phx-click="edit" phx-value-id={member.id}>
                      Change their seat
                    </button>
                    <span
                      :if={not changeable?(member, @owners)}
                      style="font-size:11.5px;color:var(--faint)"
                    >
                      The only owner — role is fixed
                    </span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <.empty
            :if={@members == []}
            title="Nobody here yet"
            body="Invite a second shooter, an editor or whoever does your books — each role opens a different part of the studio."
          />
        </div>

        <div style="display:flex;flex-direction:column;gap:12px">
          <div class="panel">
            <div class="ph-head">
              <h3>Invite someone</h3>
            </div>
            <.form for={@invite_form} phx-submit="invite" class="form" style="gap:12px">
              <.field label="Their email">
                <input
                  type="email"
                  name="invitation[email]"
                  value={@invite_form.params["email"]}
                  placeholder="jonas@example.com"
                  required
                />
                <.errors field={@invite_form[:email]} />
              </.field>

              <.field label="What they can see">
                <select name="invitation[role]">
                  <option
                    :for={{label, value} <- role_options()}
                    value={value}
                    selected={value == @invite_form.params["role"]}
                  >
                    {label}
                  </option>
                </select>
                <.errors field={@invite_form[:role]} />
              </.field>

              <.form_actions>
                <button type="submit" class="btn primary">Create the link</button>
              </.form_actions>
            </.form>

            <div class="hint" style="margin-top:10px">
              <b>Roles are the whole permission system</b>
              <span style="display:block;margin-top:2px">
                A photographer never sees money. Finance never sees client galleries. HR never
                sees client data.
              </span>
            </div>
          </div>

          <div class="panel">
            <div class="ph-head">
              <h3>Waiting to join</h3>
            </div>
            <div :if={@invitations != []} class="list">
              <div :for={invitation <- @invitations} class="it">
                <span class="dot warn"></span>
                <span style="flex:1;min-width:0">
                  <b>{invitation.email}</b>
                  <span class="sub">
                    {role_label(invitation.role)} · {invitation_expiry(@current_scope, invitation)}
                  </span>
                </span>
                <button
                  class="btn sm ghost"
                  phx-click="revoke-invite"
                  phx-value-id={invitation.id}
                >
                  Revoke
                </button>
              </div>
            </div>
            <.empty :if={@invitations == []} title="Nobody outstanding" />
          </div>
        </div>
      </div>

      <div :if={@tab == "leave"} class="split">
        <div>
          <div :if={@leave != []} class="tablewrap">
            <table style="min-width:520px">
              <thead>
                <tr>
                  <th>Who</th>
                  <th>When</th>
                  <th>Why</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <tr :for={request <- @leave}>
                  <td>{leave_person(request)}</td>
                  <td>{leave_dates(@current_scope, request)}</td>
                  <td>
                    {String.capitalize(request.kind)}
                    <span
                      :if={request.reason}
                      style="display:block;color:var(--faint);font-size:12px"
                    >
                      {request.reason}
                    </span>
                  </td>
                  <td>
                    <span class={["pill", leave_status_tone(request.status)]}>
                      {String.capitalize(request.status)}
                    </span>
                  </td>
                  <td style="text-align:right;white-space:nowrap">
                    <button
                      :if={request.status == "pending" and can?(@current_scope, :"leave.approve")}
                      class="btn sm"
                      phx-click="approve-leave"
                      phx-value-id={request.id}
                    >
                      Approve
                    </button>
                    <button
                      :if={request.status == "pending" and can?(@current_scope, :"leave.approve")}
                      class="btn sm ghost"
                      phx-click="decline-leave"
                      phx-value-id={request.id}
                    >
                      Decline
                    </button>
                    <button
                      :if={
                        request.status in ~w(pending approved) and
                          request.user_id == @current_scope.user.id
                      }
                      class="btn sm ghost"
                      phx-click="cancel-leave"
                      phx-value-id={request.id}
                      data-confirm="Withdraw this request? The dates go back on the calendar."
                    >
                      Withdraw
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <.empty
            :if={@leave == []}
            title="Nobody has asked for time off"
            body="Approving a request blocks the dates on the calendar, so nobody can be booked while they are away."
          />
        </div>

        <div class="panel">
          <div class="ph-head">
            <h3>Ask for time off</h3>
          </div>
          <.form for={to_form(%{}, as: :leave)} phx-submit="request-leave" class="form">
            <.field :if={can?(@current_scope, :"leave.approve")} label="Who is away">
              <select name="leave[user_id]">
                <option :for={member <- @members} value={member.user_id}>
                  {member_name(member)}
                </option>
              </select>
            </.field>

            <.field label="What kind">
              <select name="leave[kind]">
                <option :for={{label, value} <- leave_kinds()} value={value}>{label}</option>
              </select>
            </.field>

            <.row layout="two">
              <.field label="First day">
                <input type="date" name="leave[starts_on]" required />
              </.field>
              <.field label="Last day">
                <input type="date" name="leave[ends_on]" required />
              </.field>
            </.row>

            <.field label="Why">
              <input type="text" name="leave[reason]" placeholder="Optional" />
            </.field>

            <div class="hint">
              <b>Approval blocks the calendar</b>
              <span style="display:block;margin-top:2px">
                It goes on as a hold, so a shoot already booked over it shows as a clash rather
                than being refused — somebody still has to decide which moves.
              </span>
            </div>

            <.form_actions>
              <button type="submit" class="btn primary">Ask</button>
            </.form_actions>
          </.form>
        </div>
      </div>

      <div :if={@tab == "roster"}>
        <div class="panel">
          <div class="ph-head">
            <h3>This week</h3>
            <span class="spacer"></span>
            <span class="sub" style="color:var(--faint);font-size:12px">
              {Formats.date(@current_scope, @roster_from)} – {Formats.date(
                @current_scope,
                @roster_to
              )}
            </span>
          </div>

          <div :if={@roster != []} class="roster">
            <div class="h"></div>
            <div :for={name <- weekday_names(@current_scope)} class="h">{name}</div>

            <%= for row <- @roster do %>
              <div class="nm">{member_name(row.member)}</div>
              <div :for={day <- row.days} class={day.kind} title={day.label}>{day.label}</div>
            <% end %>
          </div>

          <.empty
            :if={@roster == []}
            title="Nobody active to roster"
            body="Add somebody to the studio and their week shows up here."
          />

          <p style="color:var(--faint);font-size:11.5px;margin:10px 0 0">
            Built from the crew actually assigned to each shoot. "Away" is approved leave, which
            is a different problem from nobody being booked.
          </p>
        </div>
      </div>

      <div :if={@tab == "onboarding"} class="split">
        <div style="display:flex;flex-direction:column;gap:12px">
          <div :for={person <- @onboarding} class="panel">
            <div class="ph-head">
              <h3>{member_name(person.membership)}</h3>
              <span class="spacer"></span>
              <span class="pill">{person.done} of {person.total}</span>
            </div>

            <div class="list">
              <div :for={task <- person.tasks} class="it">
                <label class="checkfield" style="flex:1;min-width:0">
                  <input
                    type="checkbox"
                    checked={not is_nil(task.done_at)}
                    phx-click="toggle-task"
                    phx-value-id={task.id}
                  />
                  <span style={
                    if task.done_at, do: "color:var(--faint);text-decoration:line-through"
                  }>
                    {task.label}
                  </span>
                </label>
              </div>
            </div>

            <.form
              for={to_form(%{}, as: :task)}
              phx-submit="add-task"
              class="form"
              style="margin-top:10px"
            >
              <input type="hidden" name="task[membership_id]" value={person.membership.id} />
              <div class="row two">
                <input type="text" name="task[label]" placeholder="Add a step" required />
                <button type="submit" class="btn sm">Add</button>
              </div>
            </.form>
          </div>

          <.empty
            :if={@onboarding == []}
            title="Nobody part-way through"
            body="Start a checklist for a new member and their progress shows here until it is finished."
          />
        </div>

        <div class="panel">
          <div class="ph-head">
            <h3>Start somebody off</h3>
          </div>
          <div class="list">
            <div :for={member <- @members} class="it">
              <span style="flex:1;min-width:0">
                <b>{member_name(member)}</b>
                <span class="sub">{role_label(member.role)}</span>
              </span>
              <button class="btn sm" phx-click="start-onboarding" phx-value-id={member.id}>
                Start
              </button>
            </div>
          </div>
          <p style="color:var(--faint);font-size:11.5px;margin:10px 0 0">
            Adds the studio's standard checklist. You can add steps to it afterwards.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
