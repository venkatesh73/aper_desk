<Layouts.app flash={@flash}>
  <div class="authwrap" id="setup" phx-hook="DetectTimeZone">
    <div class="authcard" style="max-width:600px">
      <a class="brand" href={~p"/"} style="margin-bottom:18px">
        <img src={~p"/images/logo-long.png"} alt="AperDesk" width="132" height="44" />
      </a>

      <h1 class="serif">Set up {@studio.name}</h1>
      <p class="sub">
        A few things we cannot guess. Currency and time zone decide how every quote and shoot is
        read, so they are worth a moment now.
      </p>

      <.form for={@form} phx-change="validate" phx-submit="save" class="form">
        <.section title="Where you are based">
          <.row layout="wide-narrow">
            <.text_field
              field={@form[:city]}
              label="City"
              autocomplete="address-level2"
              required
            />
            <.text_field
              field={@form[:country_code]}
              label="Country"
              placeholder="CH"
              maxlength="2"
              autocomplete="country"
              required
            />
          </.row>

          <.combo_field
            field={@form[:time_zone]}
            id="setup-time-zone"
            label="Time zone"
            options={Enum.map(@time_zones, &{String.replace(&1, "_", " "), &1})}
            hint="Shoot times and reply targets are shown in this zone. Detected from your browser."
            prompt="Choose a time zone"
            search_placeholder="Search cities and regions"
            empty_message="No time zone matched"
            allow_clear={false}
          />
        </.section>

        <.section title="Money">
          <.select_field
            field={@form[:base_currency]}
            label="Reporting currency"
            options={Enum.map(@currencies, &{&1, &1})}
            hint="You can still quote clients in another currency. This is the one your reports total in."
            required
          />
        </.section>

        <.section title="How dates should read">
          <.row layout="two">
            <.select_field
              field={@form[:date_format]}
              label="Date format"
              options={Enum.map(Studio.date_formats(), &{date_format_label(&1), &1})}
            />
            <.select_field
              field={@form[:time_format]}
              label="Time format"
              options={Enum.map(Studio.time_formats(), &{time_format_label(&1), &1})}
            />
          </.row>

          <.select_field
            field={@form[:week_starts_on]}
            label="Weeks start on"
            options={Enum.map(Studio.week_starts(), &{week_start_label(&1), &1})}
          />

          <div class="hint">
            Dates will look like <span class="mono">{@preview}</span>
          </div>
        </.section>

        <.section title="Replying to enquiries">
          <.select_field
            field={@form[:reply_sla_minutes]}
            label="Reply to new enquiries"
            options={Enum.map(sla_options(), fn {label, minutes} -> {label, minutes} end)}
            hint="The dashboard measures against this. Nothing is sent automatically."
          />
        </.section>

        <.form_actions>
          <button type="submit" class="btn primary">Save and continue</button>
        </.form_actions>
      </.form>
    </div>
  </div>
</Layouts.app>
