<Layouts.app flash={@flash}>
  <div class="app">
    <.sidebar current_scope={@current_scope} active={:templates} />

    <div class="main">
      <%= if @live_action == :index do %>
        <.topbar
          title="Templates"
          subtitle="Written once, sent often. Nothing here is sent automatically."
        >
          <:actions>
            <a class="btn primary" href={~p"/app/templates/#{@tab}/new"}>
              + New {label(@tab)}
            </a>
          </:actions>
        </.topbar>

        <div class="seg" style="margin-bottom:14px">
          <button
            :for={tab <- tabs()}
            aria-pressed={to_string(@tab == tab)}
            phx-click="switch-tab"
            phx-value-tab={tab}
          >
            {tab_label(tab)}
          </button>
        </div>

        <%= case @tab do %>
          <% "email" -> %>
            <.empty
              :if={@email_templates == []}
              title="No email templates yet"
              body="An enquiry reply, a booking confirmation, a gallery-ready note."
            />
            <div :if={@email_templates != []} class="tablewrap">
              <table>
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Subject</th>
                    <th>Shoot type</th>
                    <th>Key</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={template <- @email_templates}>
                    <td>
                      <span class="name">{template.name}</span>
                      <span :if={template.system_template} class="pill">starter</span>
                    </td>
                    <td>{template.subject}</td>
                    <td>{humanise(template.shoot_type)}</td>
                    <td class="mono">{template.key}</td>
                    <td style="text-align:right">
                      <button
                        class="btn sm"
                        phx-click="preview"
                        phx-value-kind="email"
                        phx-value-id={template.id}
                      >
                        Preview
                      </button>
                      <a class="btn sm" href={~p"/app/templates/email/#{template}/edit"}>Edit</a>
                      <button
                        class="btn sm ghost"
                        phx-click="archive"
                        phx-value-kind="email"
                        phx-value-id={template.id}
                        data-confirm="Archive this template? Workflows using it will stop finding it."
                      >
                        Archive
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          <% "contract" -> %>
            <.empty
              :if={@contract_templates == []}
              title="No contract templates yet"
              body="Write your terms once; clients sign on their phone."
            />
            <div :if={@contract_templates != []} class="tablewrap">
              <table>
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Shoot type</th>
                    <th>Deposit</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={template <- @contract_templates}>
                    <td><span class="name">{template.name}</span></td>
                    <td>{humanise(template.shoot_type)}</td>
                    <td>{if template.requires_deposit, do: "Required", else: "Not required"}</td>
                    <td style="text-align:right">
                      <button
                        class="btn sm"
                        phx-click="preview"
                        phx-value-kind="contract"
                        phx-value-id={template.id}
                      >
                        Preview
                      </button>
                      <a class="btn sm" href={~p"/app/templates/contract/#{template}/edit"}>
                        Edit
                      </a>
                      <button
                        class="btn sm ghost"
                        phx-click="archive"
                        phx-value-kind="contract"
                        phx-value-id={template.id}
                        data-confirm="Archive this template? Contracts already drafted are untouched."
                      >
                        Archive
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          <% "questionnaire" -> %>
            <.empty
              :if={@forms == []}
              title="No questionnaires yet"
              body="Embed one on your site and every submission arrives as a tracked lead."
            />
            <div :if={@forms != []} class="tablewrap">
              <table>
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Link</th>
                    <th>Questions</th>
                    <th>Submissions</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={form <- @forms}>
                    <td>
                      <span class="name">{form.name}</span>
                      <span :if={not form.active} class="pill">inactive</span>
                    </td>
                    <td class="mono">/f/{form.slug}</td>
                    <td>{length(AperDesk.Comms.LeadCaptureForm.field_list(form))}</td>
                    <td>{form.submission_count}</td>
                    <td style="text-align:right">
                      <button
                        class="btn sm"
                        phx-click="preview"
                        phx-value-kind="questionnaire"
                        phx-value-id={form.id}
                      >
                        Preview
                      </button>
                      <a class="btn sm" href={~p"/app/templates/questionnaire/#{form}/edit"}>
                        Edit
                      </a>
                      <button
                        :if={form.active}
                        class="btn sm ghost"
                        phx-click="archive"
                        phx-value-kind="questionnaire"
                        phx-value-id={form.id}
                        data-confirm="Deactivate this form? The embed will stop accepting submissions."
                      >
                        Deactivate
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          <% "invoice" -> %>
            <div :if={@invoice_templates != []} class="tablewrap">
              <table>
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Raised as</th>
                    <th>Due</th>
                    <th>Tax</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={template <- @invoice_templates}>
                    <td>
                      <span class="name">{template.name}</span>
                      <span :if={template.is_default} class="pill ok">default</span>
                      <span :if={template.shoot_type} class="pill">
                        {humanise(template.shoot_type)}
                      </span>
                    </td>
                    <td>{humanise(template.kind)}</td>
                    <td>{due_line(template)}</td>
                    <td class="mono">
                      {if template.tax_bps > 0,
                        do: "#{tax_percent_value(template)}%",
                        else: "—"}
                    </td>
                    <td style="text-align:right">
                      <button
                        class="btn sm"
                        phx-click="preview"
                        phx-value-kind="invoice"
                        phx-value-id={template.id}
                      >
                        Preview
                      </button>
                      <a class="btn sm" href={~p"/app/templates/invoice/#{template}/edit"}>
                        Edit
                      </a>
                      <button
                        class="btn sm ghost"
                        phx-click="archive"
                        phx-value-kind="invoice"
                        phx-value-id={template.id}
                        data-confirm="Archive this template? Invoices already raised from it are untouched."
                      >
                        Archive
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <.empty
              :if={@invoice_templates == []}
              title="No invoice templates yet"
              body="Terms you write once — when it is due, what tax applies, how to pay — and reach for whenever you raise an invoice."
            />
        <% end %>
      <% else %>
        <.topbar
          title={if @record, do: "Edit #{label(@kind)}", else: "New #{label(@kind)}"}
          subtitle="Nothing here is sent without you approving it."
        >
          <:actions>
            <a class="btn" href={~p"/app/templates?tab=#{@kind}"}>Cancel</a>
          </:actions>
        </.topbar>

        <div class="formpanel">
          <.form for={@form} phx-change="validate" phx-submit="save" class="form">
            <.section title="Name it">
              <.text_field field={@form[:name]} label="Name" required />

              <.text_field
                :if={@kind == "email"}
                field={@form[:key]}
                label="Key"
                placeholder="enquiry_reply"
                hint="How workflows refer to it. Lowercase letters, numbers and underscores."
                required
              />
            </.section>

            <.section :if={@kind == "email"} title="The message">
              <.text_field
                field={@form[:subject]}
                label="Subject"
                placeholder="Thanks for getting in touch, {{first_name}}"
                required
              />
              <.textarea_field field={@form[:body]} label="Message" rows={12} required />

              <div class="hint">
                <span class="eyebrow">Placeholders</span>
                <div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:8px">
                  <span :for={token <- tokens()} class="mono">
                    &#123;&#123;{token}&#125;&#125;
                  </span>
                </div>
                <span style="display:block;margin-top:8px">
                  An unknown placeholder is left visible rather than blanked, so a mistake is
                  obvious in a test send instead of arriving as a gap.
                </span>
              </div>
            </.section>

            <.section :if={@kind == "contract"} title="The terms">
              <.textarea_field field={@form[:body]} label="Terms" rows={16} required />
              <.checkbox_field
                field={@form[:requires_deposit]}
                label="A deposit is required at signature"
                checked_default={true}
              />
            </.section>

            <.section :if={@kind == "questionnaire"} title="What the client sees">
              <.text_field
                field={@form[:headline]}
                label="Headline"
                placeholder="Tell us about your day"
              />
              <.textarea_field field={@form[:intro]} label="Intro" rows={3} />
              <.textarea_field
                field={@form[:success_message]}
                label="Thank-you message"
                rows={2}
              />
            </.section>

            <div :if={@kind == "questionnaire"} class="sect">
              <div class="sect-head with-action">
                <h3>The questions</h3>
                <span class="spacer"></span>
                <button type="button" class="btn sm" phx-click="add-question">
                  + Add a question
                </button>
              </div>

              <div :for={{question, index} <- Enum.with_index(@questions)} class="qrow">
                <div class="qrow-head">
                  <span class="qnum">{index + 1}</span>
                  <input
                    type="text"
                    name={"template[questions][#{index}][label]"}
                    value={question["label"]}
                    placeholder="What are you asking?"
                    class="qlabel"
                  />
                  <select name={"template[questions][#{index}][type]"} class="qtype">
                    <option
                      :for={{label, value} <- question_types()}
                      value={value}
                      selected={value == question["type"]}
                    >
                      {label}
                    </option>
                  </select>

                  <button
                    type="button"
                    class="btn icon ghost sm"
                    phx-click="move-question"
                    phx-value-index={index}
                    phx-value-by="-1"
                    disabled={index == 0}
                    title="Move up"
                  >
                    ↑
                  </button>
                  <button
                    type="button"
                    class="btn icon ghost sm"
                    phx-click="move-question"
                    phx-value-index={index}
                    phx-value-by="1"
                    disabled={index == length(@questions) - 1}
                    title="Move down"
                  >
                    ↓
                  </button>
                  <button
                    type="button"
                    class="btn icon ghost sm"
                    phx-click="remove-question"
                    phx-value-index={index}
                    title="Remove"
                  >
                    ×
                  </button>
                </div>

                <div class="qrow-body">
                  <label class="checkfield">
                    <input
                      type="hidden"
                      name={"template[questions][#{index}][required]"}
                      value="false"
                    />
                    <input
                      type="checkbox"
                      name={"template[questions][#{index}][required]"}
                      value="true"
                      checked={question["required"]}
                    />
                    <span>They have to answer it</span>
                  </label>

                  <input
                    type="text"
                    name={"template[questions][#{index}][placeholder]"}
                    value={question["placeholder"]}
                    placeholder="Hint text (optional)"
                  />

                  <input
                    type="hidden"
                    name={"template[questions][#{index}][key]"}
                    value={question["key"]}
                  />
                </div>

                <div :if={needs_options?(question["type"])} class="qrow-body">
                  <textarea
                    name={"template[questions][#{index}][options]"}
                    rows="3"
                    placeholder="One choice per line"
                  >{question["options"]}</textarea>
                </div>
              </div>

              <p :if={@questions == []} style="color:var(--muted);font-size:13px;margin:0">
                No questions yet. A form with none collects an email address and nothing else —
                add the things you actually need to know before quoting.
              </p>

              <p style="color:var(--faint);font-size:11.5px;margin:8px 0 0">
                Answers arrive under the question's key, which is set from the label the first
                time and then left alone — renaming a question does not orphan the answers
                already collected under it.
              </p>
            </div>

            <.section :if={@kind == "invoice"} title="How it is raised">
              <.row layout="two">
                <.select_field field={@form[:kind]} label="Raised as" options={invoice_kinds()} />
                <.text_field
                  field={@form[:due_in_days]}
                  label="Due, in days"
                  type="number"
                  min="0"
                  hint="Counted from the day it is issued."
                />
              </.row>

              <.row layout="two">
                <.field label="Tax rate" hint="A percentage — 23 for VAT at 23%.">
                  <input
                    type="number"
                    step="0.01"
                    min="0"
                    max="100"
                    name="template[tax_percent]"
                    value={@form.params["tax_percent"] || tax_percent_value(@form.source.data)}
                  />
                </.field>
                <.text_field
                  field={@form[:tax_label]}
                  label="What to call it"
                  placeholder="VAT"
                />
              </.row>

              <.text_field
                :if={@form[:kind].value == "deposit"}
                field={@form[:deposit_percent]}
                label="Deposit percentage"
                type="number"
                min="0"
                max="100"
                hint="The share of the total asked for up front."
              />

              <.textarea_field
                field={@form[:notes]}
                label="Notes on the invoice"
                rows={3}
                placeholder="The date is held once the deposit clears."
              />
              <.textarea_field
                field={@form[:payment_instructions]}
                label="How to pay"
                rows={3}
                placeholder="Bank transfer to …"
              />

              <.checkbox_field
                field={@form[:is_default]}
                label="Reach for this one by default"
                hint="A template matching the shoot type is preferred over the default."
              />
            </.section>

            <.section :if={@kind in ["email", "contract", "invoice"]} title="When to offer it">
              <.combo_field
                id="template-shoot-type"
                field={@form[:shoot_type]}
                label="Shoot type"
                options={Enum.map(shoot_types(), &{humanise(&1), &1})}
                hint="Leave as any to offer it for every shoot."
              />
            </.section>

            <.form_actions>
              <button type="submit" class="btn primary">
                {if @record, do: "Save changes", else: "Create"}
              </button>
              <button type="button" class="btn" phx-click="preview-draft">
                Preview
              </button>
              <a class="btn ghost" href={~p"/app/templates?tab=#{@kind}"}>Cancel</a>
            </.form_actions>
          </.form>
        </div>
      <% end %>

      <.modal
        :if={@preview}
        id="template-preview"
        title={@preview.title}
        subtitle="Shown with sample details, so you can read it the way the client will."
      >
        <%= case @preview.kind do %>
          <% "email" -> %>
            <div class="mailprev">
              <div class="mailprev-head">
                <div class="kv">
                  <span>From</span>
                  <span>{@preview.from}</span>
                  <span>To</span>
                  <span>{@preview.to}</span>
                  <span>Subject</span>
                  <span><b>{@preview.subject}</b></span>
                </div>
              </div>
              <div class="mailprev-body">{@preview.body}</div>
            </div>
          <% "contract" -> %>
            <div class="docprev">
              <h2>{@preview.title}</h2>
              <p class="docprev-meta">
                Between <b>{@preview.studio}</b> and <b>{@preview.client}</b>
              </p>
              <div class="docprev-body">{@preview.body}</div>
              <div :if={@preview.requires_deposit} class="hint">
                <b>A deposit of {@preview.deposit} is taken at signature</b>
                <span style="display:block;margin-top:2px">
                  The date is not held until it clears.
                </span>
              </div>
              <div class="docprev-sign">
                <span>Signed</span>
                <span>Date</span>
              </div>
            </div>
          <% "invoice" -> %>
            <div class="docprev">
              <h2>Invoice</h2>
              <p class="docprev-meta">
                From <b>{@preview.studio}</b> to <b>{@preview.client}</b> ·
                issued {@preview.issued_on} · due {@preview.due_on}
              </p>

              <div class="kv" style="margin-bottom:12px">
                <span>Subtotal</span>
                <span>{@preview.subtotal}</span>
                <span :if={@preview.tax_percent > 0}>
                  {@preview.tax_label} at {@preview.tax_percent}%
                </span>
                <span :if={@preview.tax_percent > 0}>{@preview.tax}</span>
              </div>

              <div class="kv" style="font-size:17px;font-weight:700">
                <span style="color:var(--faint);font-weight:400">Total</span>
                <span>{@preview.total}</span>
              </div>

              <div :if={@preview.notes} class="docprev-body" style="margin-top:14px">
                {@preview.notes}
              </div>

              <div :if={@preview.payment_instructions} class="hint">
                <b>How to pay</b>
                <span style="display:block;margin-top:2px;white-space:pre-wrap">
                  {@preview.payment_instructions}
                </span>
              </div>

              <p style="color:var(--faint);font-size:11.5px;margin-top:12px">
                Shown against a {@preview.subtotal} shoot, so the tax and the total are the real
                arithmetic rather than placeholders.
              </p>
            </div>
          <% _questionnaire -> %>
            <div class="formprev">
              <h2 :if={@preview.headline}>{@preview.headline}</h2>
              <p :if={@preview.intro} class="docprev-meta">{@preview.intro}</p>

              <div :if={@preview.fields != []} class="form">
                <.field :for={field <- @preview.fields} label={field["label"]}>
                  <%= case input_type(field["type"]) do %>
                    <% "textarea" -> %>
                      <textarea rows="3" disabled placeholder={field["placeholder"]}></textarea>
                    <% "select" -> %>
                      <select disabled>
                        <option>Choose one</option>
                        <option :for={option <- field_options(field)}>{option}</option>
                      </select>
                    <% "checkbox" -> %>
                      <label class="checkfield">
                        <input type="checkbox" disabled />
                        <span>{field["label"]}</span>
                      </label>
                    <% type -> %>
                      <input type={type} disabled placeholder={field["placeholder"]} />
                  <% end %>
                  <span :if={field["required"] in [true, "true"]} class="hint-line">
                    Required
                  </span>
                </.field>

                <button class="btn primary" disabled>Send it</button>
              </div>

              <p :if={@preview.fields == []} style="color:var(--muted)">
                No questions yet. A questionnaire with no fields collects nothing but an email
                address.
              </p>

              <div :if={@preview.success_message} class="hint">
                <b>After they send it they see</b>
                <span style="display:block;margin-top:2px">{@preview.success_message}</span>
              </div>
            </div>
        <% end %>
      </.modal>
    </div>
  </div>
</Layouts.app>
