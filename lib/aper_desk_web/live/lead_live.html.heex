<Layouts.app flash={@flash}>
  <div class="app">
    <.sidebar current_scope={@current_scope} active={:leads} />

    <div class="main">
      <%= if @live_action == :new do %>
        <.topbar title="New lead" subtitle="Only a title is required. The rest can follow.">
          <:actions>
            <a class="btn" href={~p"/app/leads"}>Cancel</a>
          </:actions>
        </.topbar>

        <div class="formpanel">
          <.form for={@form} phx-change="validate" phx-submit="save" class="form">
            <.section title="The enquiry">
              <.text_field
                field={@form[:title]}
                label="What is the enquiry?"
                placeholder="Summer wedding at Villa Rosa"
                required
              />

              <.field label="Client" hint="Search by name or email.">
                <.live_component
                  module={AperDeskWeb.Combobox}
                  id="lead-contact"
                  name="lead[contact_id]"
                  value={@form[:contact_id].value}
                  options={contact_options(@contacts)}
                  prompt="Not linked to a contact yet"
                  search_placeholder="Search contacts"
                  empty_message="No contact matched"
                />
                <:hint_block>
                  Not listed?
                  <a href={~p"/app/contacts/new"} style="color:var(--accent-text)">
                    Add a contact
                  </a>
                  first.
                </:hint_block>
              </.field>

              <.combo_field
                field={@form[:shoot_type]}
                id="lead-shoot-type"
                label="Shoot type"
                options={Enum.map(shoot_types(), &{humanise(&1), &1})}
                prompt="Choose a shoot type"
                search_placeholder="Search shoot types"
                allow_clear={false}
              />
            </.section>

            <.section title="The shoot" description="All optional — fill in what you know.">
              <.row layout="wide-narrow">
                <.text_field field={@form[:location]} label="Venue or location" />
                <.text_field field={@form[:desired_date]} label="Shoot date" type="date" />
              </.row>

              <.row>
                <.text_field field={@form[:guest_count]} label="Guests" type="number" min="0" />
                <.field label="Budget" hint="Enter it the way you would say it — 4500.">
                  <div class="row amount">
                    <input
                      type="number"
                      id="lead_budget_major"
                      name="lead[budget_major]"
                      value={@budget_major}
                      min="0"
                      step="0.01"
                      placeholder="4500"
                    />
                    <input
                      type="text"
                      name="lead[budget_currency]"
                      value={@form[:budget_currency].value || @current_scope.currency}
                    />
                  </div>
                </.field>
              </.row>
            </.section>

            <.section title="Where it came from">
              <.combo_field
                field={@form[:source]}
                id="lead-source"
                label="Source"
                options={Enum.map(sources(), &{humanise(&1), &1})}
                prompt="Choose a source"
                search_placeholder="Search sources"
                allow_clear={false}
              />
            </.section>

            <.form_actions>
              <button type="submit" class="btn primary">Create lead</button>
              <a class="btn ghost" href={~p"/app/leads"}>Cancel</a>
            </.form_actions>
          </.form>
        </div>
      <% else %>
        <.topbar title={display_name(@lead)} subtitle={@lead.title}>
          <:actions>
            <a class="btn" href={~p"/app/leads"}>All leads</a>
            <button
              :if={is_nil(@lead.first_responded_at)}
              class="btn"
              phx-click="replied"
            >
              I have replied
            </button>
            <button
              :if={next_stage(@lead)}
              class="btn primary"
              phx-click="move"
              phx-value-stage={next_stage(@lead)}
            >
              Move to {humanise(next_stage(@lead))}
            </button>
          </:actions>
        </.topbar>

        <div class="stats">
          <.stat label="Stage" value={humanise(@lead.stage)} />
          <.stat
            label="Shoot date"
            value={shoot_date(@current_scope, @lead) || "Not set"}
          />
          <.stat label="Value" value={value(@lead) || "—"} />
          <.stat
            label="First reply"
            value={if @lead.first_responded_at, do: "Sent", else: "Waiting"}
            detail={
              if overdue?(@lead), do: "past the SLA", else: time_ago(@lead.first_response_due_at)
            }
            tone={if overdue?(@lead), do: :down, else: :neutral}
          />
        </div>

        <div class="dash">
          <div style="display:flex;flex-direction:column;gap:12px;min-width:0">
            <div class="panel">
              <div class="ph-head">
                <h3>The enquiry</h3>
              </div>
              <div class="kv" style="padding:12px 14px">
                <span>Client</span>
                <span>
                  <a :if={@lead.contact} href={~p"/app/contacts/#{@lead.contact}"}>
                    {@lead.contact.name}
                  </a>
                  <span :if={is_nil(@lead.contact)} style="color:var(--faint)">Not linked</span>
                </span>
                <span>Email</span>
                <span>{(@lead.contact && @lead.contact.email) || "—"}</span>
                <span>Shoot type</span><span>{humanise(@lead.shoot_type)}</span>
                <span>Venue</span><span>{@lead.location || "—"}</span>
                <span>Guests</span><span>{@lead.guest_count || "—"}</span>
                <span>Source</span><span>{humanise(@lead.source)}</span>
                <span>Owner</span>
                <span>{(@lead.owner && @lead.owner.name) || "Unassigned"}</span>
                <span :if={@lead.lost_reason}>Lost because</span>
                <span :if={@lead.lost_reason}>{@lead.lost_reason}</span>
              </div>
            </div>

            <div class="panel">
              <div class="ph-head">
                <h3>Activity</h3>
              </div>
              <div :if={@activity != []} class="list">
                <div :for={entry <- @activity} class="it">
                  <span class="dot"></span>
                  <span>
                    <b>{entry.summary}</b>
                    <span :if={entry.reason} class="sub">{entry.reason}</span>
                  </span>
                  <span class="t">{time_ago(entry.occurred_at)}</span>
                </div>
              </div>
              <.empty
                :if={@activity == []}
                title="Nothing logged yet"
                body="Every change to this lead will appear here, with the reason."
              />
            </div>
          </div>

          <div style="display:flex;flex-direction:column;gap:12px;min-width:0">
            <div class="panel">
              <div class="ph-head">
                <h3>Before this can be booked</h3>
              </div>
              <div class="list">
                <div :for={item <- readiness(@lead)} class="it">
                  <span class={["dot", not item.done && "off"]}></span>
                  <span><b>{item.label}</b></span>
                  <span class="t">{if item.done, do: "done", else: "to do"}</span>
                </div>
              </div>
            </div>

            <div class="panel">
              <div class="ph-head">
                <h3>Move the lead</h3>
              </div>
              <div style="padding:12px 14px;display:flex;flex-wrap:wrap;gap:6px">
                <button
                  :for={stage <- stages()}
                  :if={stage not in ["lost"] and stage != @lead.stage}
                  class="chip"
                  phx-click="move"
                  phx-value-stage={stage}
                >
                  {humanise(stage)}
                </button>
              </div>

              <div :if={@lead.stage != "lost"} style="padding:0 14px 14px">
                <.form for={%{}} as={:lost} phx-submit="lose">
                  <label for="lost_reason">Or mark it lost</label>
                  <input
                    type="text"
                    id="lost_reason"
                    name="lost[reason]"
                    placeholder="Chose another photographer"
                    required
                  />
                  <span class="formhint">
                    A reason is required, so the pipeline stays worth reading.
                  </span>
                  <button type="submit" class="btn sm" style="margin-top:8px">Mark lost</button>
                </.form>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
