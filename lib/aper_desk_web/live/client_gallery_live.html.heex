<%= if @stage == :open do %>
  <Layouts.flash_group flash={@flash} />

  <div class="cg">
    <div class="cg-nav">
      <b>{@gallery.studio.name}</b>
      <span class="who">{@gallery.title}</span>
      <div class="tabs">
        <a class={@filter == "all" && "on"} href="#" phx-click="filter" phx-value-filter="all">
          All photos
        </a>
        <a
          class={@filter == "favourited" && "on"}
          href="#"
          phx-click="filter"
          phx-value-filter="favourited"
        >
          Your favourites
        </a>
      </div>
    </div>

    <div :if={cover(@gallery, @media)} class="cg-hero">
      <img src={photo_url(cover(@gallery, @media))} alt="" />
      <div class="cap">
        <h1>{@gallery.title}</h1>
        <div class="d">{@gallery.media_count} photographs</div>
      </div>
    </div>

    <div :if={@gallery.description} class="cg-note">
      <span>{@gallery.description}</span>
    </div>

    <div :if={visible(@media, @filter, @favourites) != []} class="masonry">
      <div
        :for={media <- visible(@media, @filter, @favourites)}
        class={["mi", MapSet.member?(@favourites, media.id) && "fav"]}
      >
        <img src={photo_url(media)} alt={media.filename} loading="lazy" />
        <div class="act">
          <button class="hrt" phx-click="favourite" phx-value-id={media.id} title="Favourite">
            ♥
          </button>
          <span class="num">{media.filename}</span>
        </div>
      </div>
    </div>

    <div
      :if={visible(@media, @filter, @favourites) == []}
      style="padding:48px 28px;text-align:center;color:var(--faint)"
    >
      <p :if={@filter == "favourited"}>
        Nothing favourited yet. Tap the heart on the ones you love.
      </p>
      <p :if={@filter != "favourited"}>The photographs are not up yet.</p>
    </div>

    <div class="cg-bar">
      <span class="k">Favourites</span>
      <b>{MapSet.size(@favourites)}</b>
      <span :if={@gallery.selection_limit} class="k">
        · pick up to {@gallery.selection_limit}
      </span>
      <span class="spacer"></span>
      <span :if={not @gallery.download_enabled} class="k">
        Downloads are off for this gallery
      </span>
    </div>

    <div class="cg-foot">
      <span :if={@gallery.show_studio_badge}>{@gallery.studio.name}</span>
      <span>Your picks are saved as you make them.</span>
    </div>
  </div>
<% else %>
  <Layouts.flash_group flash={@flash} />

  <div style="min-height:100vh;display:grid;place-items:center;padding:24px;text-align:center">
    <div style="max-width:420px;width:100%">
      <%!-- The gate. The gallery title is the only thing shown before a code is
      redeemed, because everything else is the thing being protected. --%>
      <div :if={@stage in [:email, :code]}>
        <h1 style="font-family:Fraunces,Georgia,serif;font-weight:400;font-size:32px">
          {@gallery.title}
        </h1>
        <p style="color:var(--muted);margin-top:10px">
          {@gallery.studio.name} asked us to check it is you before opening this gallery.
        </p>

        <form :if={@stage == :email} phx-submit="request-code" style="margin-top:22px">
          <div class="field">
            <label for="gate-email">Your email address</label>
            <input
              id="gate-email"
              name="email"
              type="email"
              value={@email}
              required
              autocomplete="email"
              placeholder="you@example.com"
            />
          </div>
          <button class="btn primary" type="submit" style="width:100%;margin-top:12px">
            Email me a code
          </button>
          <p style="color:var(--faint);font-size:12px;margin-top:12px">
            The code goes to the address your photographer sent this link to, so it only arrives
            if the one you enter is the same.
          </p>
        </form>

        <form :if={@stage == :code} phx-submit="submit-code" style="margin-top:22px">
          <div class="field">
            <label for="gate-code">The six-digit code</label>
            <input
              id="gate-code"
              name="code"
              type="text"
              inputmode="numeric"
              pattern="[0-9]*"
              maxlength="6"
              autocomplete="one-time-code"
              required
              autofocus
              placeholder="000000"
              style="text-align:center;letter-spacing:6px;font-size:20px"
            />
          </div>
          <button class="btn primary" type="submit" style="width:100%;margin-top:12px">
            Open the gallery
          </button>
          <p style="color:var(--faint);font-size:12px;margin-top:12px">
            If it is your address, a code is on its way. It lasts 15 minutes.
            <a href="#" phx-click="start-over" style="color:var(--muted)">
              Use a different address
            </a>
          </p>
        </form>

        <p :if={@error} class="bad-text" style="margin-top:14px;font-size:13px">{@error}</p>
      </div>

      <%!-- The studio turned the code on for a link it never addressed to
      anyone. There is nowhere to send a code, and guessing an address would
      defeat the point of asking for one. --%>
      <div :if={@stage == :unaddressed}>
        <h1 style="font-family:Fraunces,Georgia,serif;font-weight:400;font-size:32px">
          This link needs a name on it
        </h1>
        <p style="color:var(--muted);margin-top:10px">
          The gallery asks for a code, but this link was not addressed to anyone, so there is no
          one to send it to. Ask your photographer for a link addressed to your email.
        </p>
      </div>

      <div :if={@stage == :closed}>
        <h1 style="font-family:Fraunces,Georgia,serif;font-weight:400;font-size:32px">
          This link does not open anything
        </h1>
        <p style="color:var(--muted);margin-top:10px">
          It may have been replaced, or the gallery's window may have closed. Ask your photographer
          for a new one.
        </p>
      </div>
    </div>
  </div>
<% end %>
