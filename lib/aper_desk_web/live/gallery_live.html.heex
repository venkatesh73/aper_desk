<Layouts.app flash={@flash}>
  <div class="app">
    <.sidebar current_scope={@current_scope} active={:galleries} />

    <div class="main">
      <.topbar title={@gallery.title} subtitle={subtitle(@current_scope, @gallery)}>
        <:actions>
          <a class="btn ghost sm" href={~p"/app/galleries"}>← Galleries</a>
          <button :if={@gallery.status != "delivered"} class="btn" phx-click="deliver">
            Deliver to the client
          </button>
          <button class="btn primary" phx-click="share">Create a share link</button>
        </:actions>
      </.topbar>

      <div class="gd">
        <div class="card albums">
          <span class="eyebrow">Albums</span>
          <a class={is_nil(@album) && "on"} href="#" phx-click="album" phx-value-album="">
            All photos<span class="n">{length(@media)}</span>
          </a>
          <a
            :for={{name, count} <- @albums}
            class={@album == name && "on"}
            href="#"
            phx-click="album"
            phx-value-album={name}
          >
            {name}<span class="n">{count}</span>
          </a>

          <div class="hr" style="margin:8px 0"></div>
          <span class="eyebrow">Client picks</span>
          <a href="#" phx-click="filter" phx-value-filter="favourited">
            Favourites<span class="n">{length(@favourites)}</span>
          </a>
          <a href="#" phx-click="filter" phx-value-filter="all">
            Album selection<span class="n">
              {length(@picks)}{if @gallery.selection_limit, do: " / #{@gallery.selection_limit}"}
            </span>
          </a>

          <div class="hr" style="margin:8px 0"></div>
          <div style="padding:0 8px">
            <span class="help" style="font-size:11.5px;color:var(--faint);display:block">
              {size(@gallery.bytes_total)} · {window_line(@current_scope, @gallery)}
            </span>
          </div>
        </div>

        <div class="card" style="min-width:0">
          <form
            class="gtool"
            id="upload-form"
            phx-submit="upload"
            phx-change="validate-upload"
          >
            <button
              class="chip"
              type="button"
              aria-pressed={to_string(@filter == "all")}
              phx-click="filter"
              phx-value-filter="all"
            >
              All
            </button>
            <button
              class="chip"
              type="button"
              aria-pressed={to_string(@filter == "favourited")}
              phx-click="filter"
              phx-value-filter="favourited"
            >
              Favourited
            </button>
            <span class="spacer"></span>
            <.live_file_input upload={@uploads.photos} />
            <button
              class="btn sm primary"
              type="submit"
              disabled={@uploads.photos.entries == []}
            >
              Upload
            </button>
          </form>

          <div :if={@uploads.photos.entries != []} class="list" style="padding:0 10px">
            <div :for={entry <- @uploads.photos.entries} class="it">
              <span style="flex:1;min-width:0">
                <b>{entry.client_name}</b>
                <span class="sub">
                  {size(entry.client_size)}
                  <%= for error <- upload_errors(@uploads.photos, entry) do %>
                    · <span class="bad-text">{upload_error(error)}</span>
                  <% end %>
                </span>
              </span>
              <span class="t">{entry.progress}%</span>
              <button
                type="button"
                class="btn sm ghost"
                phx-click="cancel-upload"
                phx-value-ref={entry.ref}
              >
                Remove
              </button>
            </div>
            <div :for={error <- upload_errors(@uploads.photos)} class="it">
              <span class="dot bad"></span>
              <span class="bad-text">{upload_error(error)}</span>
            </div>
          </div>

          <div :if={@visible != []} class="thumbs">
            <div
              :for={media <- @visible}
              class={["th", media.id == @gallery.cover_media_id && "cover"]}
              title={media.filename}
            >
              <img src={thumb_url(media)} alt={media.filename} loading="lazy" />
              <span :if={media.favourite_count > 0} class="hb">♥ {media.favourite_count}</span>
            </div>
          </div>

          <div
            :if={@visible != []}
            class="gtool"
            style="border-top:1px solid var(--line2);border-bottom:0"
          >
            <span class="eyebrow">{length(@visible)} shown</span>
            <span class="spacer"></span>
            <select
              :if={@visible != []}
              phx-change="cover"
              name="id"
              style="width:auto;padding:4px 8px;font-size:12.5px"
            >
              <option value="">Set the cover…</option>
              <option :for={media <- @visible} value={media.id}>{media.filename}</option>
            </select>
            <select
              phx-change="remove"
              name="id"
              style="width:auto;padding:4px 8px;font-size:12.5px"
            >
              <option value="">Remove a photo…</option>
              <option :for={media <- @visible} value={media.id}>{media.filename}</option>
            </select>
          </div>

          <.empty
            :if={@visible == [] and @media == []}
            title="Nothing uploaded yet"
            body="Choose the finished frames above. They are counted against your plan's storage as they land."
          />
          <.empty
            :if={@visible == [] and @media != []}
            title="Nothing matches that filter"
            body="Clear it to see the rest of the gallery."
          />
        </div>

        <div class="gside">
          <div class="panel">
            <div class="ph-head">
              <h3>Delivery settings</h3>
            </div>
            <div class="form" style="gap:10px">
              <div class="setrow">
                <span>Downloads</span>
                <button
                  type="button"
                  class="toggle"
                  role="switch"
                  aria-checked={to_string(@gallery.download_enabled)}
                  phx-click={
                    JS.push("settings",
                      value: %{
                        gallery: %{
                          download_enabled: !@gallery.download_enabled,
                          title: @gallery.title
                        }
                      }
                    )
                  }
                >
                </button>
              </div>

              <div class="setrow">
                <span>Watermark previews</span>
                <button
                  type="button"
                  class="toggle"
                  role="switch"
                  aria-checked={to_string(@gallery.watermark_enabled)}
                  phx-click={
                    JS.push("settings",
                      value: %{
                        gallery: %{
                          watermark_enabled: !@gallery.watermark_enabled,
                          title: @gallery.title
                        }
                      }
                    )
                  }
                >
                </button>
              </div>

              <div class="setrow">
                <span>Studio badge</span>
                <button
                  type="button"
                  class="toggle"
                  role="switch"
                  aria-checked={to_string(@gallery.show_studio_badge)}
                  phx-click={
                    JS.push("settings",
                      value: %{
                        gallery: %{
                          show_studio_badge: !@gallery.show_studio_badge,
                          title: @gallery.title
                        }
                      }
                    )
                  }
                >
                </button>
              </div>

              <div class="setrow">
                <span>Email a code to open it</span>
                <button
                  type="button"
                  class="toggle"
                  role="switch"
                  aria-checked={to_string(@gallery.requires_otp)}
                  phx-click={
                    JS.push("settings",
                      value: %{
                        gallery: %{requires_otp: !@gallery.requires_otp, title: @gallery.title}
                      }
                    )
                  }
                >
                </button>
              </div>
            </div>

            <div :if={@gallery.expires_at} class="setrow" style="margin-top:10px">
              <span>Window</span>
              <span style="display:flex;gap:6px">
                <button class="btn sm" phx-click="extend" phx-value-days="30">+30 days</button>
                <button class="btn sm ghost" phx-click="extend" phx-value-days="90">+90</button>
              </span>
            </div>
          </div>

          <div class="panel">
            <div class="ph-head">
              <h3>Share</h3>
            </div>

            <div :if={@share_token} class="sharebox">
              <input value={share_url(@share_token)} readonly id="share-url" />
              <button
                class="btn sm"
                type="button"
                id="copy-share"
                phx-hook="CopyLink"
                data-copy-from="share-url"
              >
                Copy
              </button>
            </div>
            <span :if={@share_token} class="help" style="font-size:12px;color:var(--faint)">
              Copy it now. Only a hash of this link is stored, so it cannot be shown again.
            </span>

            <div :if={@shares != []} class="list" style="margin-top:8px">
              <div :for={share <- @shares} class="it">
                <span class="dot ok"></span>
                <span style="flex:1;min-width:0">
                  <b>{share.label || share.email || "Share link"}</b>
                  <span class="sub">
                    Opened {share.view_count} {if share.view_count == 1, do: "time", else: "times"}
                  </span>
                </span>
                <button class="btn sm ghost" phx-click="revoke" phx-value-id={share.id}>
                  Revoke
                </button>
              </div>
            </div>

            <.empty
              :if={@shares == [] and is_nil(@share_token)}
              title="Not shared yet"
              body="A link is the only way in — the gallery id opens nothing."
            />
          </div>

          <div class="panel">
            <div class="ph-head">
              <h3>Numbers</h3>
            </div>
            <div class="kv">
              <span>Photographs</span>
              <span>{@gallery.media_count}</span>
              <span>Storage</span>
              <span>{size(@gallery.bytes_total)}</span>
              <span>Favourites</span>
              <span>{length(@favourites)}</span>
              <span>Album picks</span>
              <span>{length(@picks)}</span>
              <span>Downloads</span>
              <span>{@gallery.download_count}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
