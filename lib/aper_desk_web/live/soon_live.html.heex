<Layouts.app flash={@flash}>
  <div class="app">
    <.sidebar current_scope={@current_scope} active={@active} />

    <div class="main">
      <.topbar title={@section.title} subtitle={@section.blurb} />

      <div class="panel">
        <div class="empty">
          <b>This screen is not built yet</b>
          <span>
            The domain behind it is: <span class="mono">{@section.backed_by}</span>
          </span>
          <div style="margin-top:16px">
            <a class="btn" href={~p"/app"}>Back to dashboard</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
