<Layouts.app flash={@flash}>
  <div class="app">
    <.sidebar current_scope={@current_scope} active={:packages} />

    <div class="main">
      <%= if @live_action == :index do %>
        <.topbar title="Packages" subtitle={"#{length(@packages)} on offer"}>
          <:actions>
            <button
              class="btn sm"
              phx-click="toggle-archived"
              aria-pressed={to_string(@show_archived)}
            >
              {if @show_archived, do: "Hide archived", else: "Show archived"}
            </button>
            <a class="btn primary" href={~p"/app/packages/new"}>+ New package</a>
          </:actions>
        </.topbar>

        <.empty
          :if={@packages == []}
          title="No packages yet"
          body="A package is what you sell: a name, a price, and what is included."
        />

        <div :if={@packages != []} class="pkgs">
          <div :for={package <- @packages} class="pcard">
            <div class="ph-head">
              <h3>{package.name}</h3>
              <span class="spacer"></span>
              <span :if={package.archived_at} class="pill">archived</span>
              <span :if={not package.public and is_nil(package.archived_at)} class="pill">
                private
              </span>
            </div>

            <div style="padding:0 14px 12px">
              <div class="price serif" style="font-size:26px">{price(package)}</div>
              <p style="margin:6px 0 0;color:var(--muted);font-size:13px">
                {package.summary || "No summary yet."}
              </p>

              <div class="kv" style="margin-top:12px">
                <span>Shoot type</span><span>{humanise(package.shoot_type)}</span>
                <span>Duration</span><span>{duration(package)}</span>
                <span>Crew</span><span>{package.crew_size}</span>
                <span>Delivery</span><span>{package.delivery_days} days</span>
                <span>Deposit</span><span>{deposit(package)} ({package.deposit_percent}%)</span>
                <span :if={package.edited_image_count}>Edited images</span>
                <span :if={package.edited_image_count}>{package.edited_image_count}</span>
              </div>

              <div :if={package.items != []} style="margin-top:12px">
                <span class="eyebrow">Included</span>
                <div class="list" style="margin-top:4px">
                  <div :for={item <- package.items} class="it">
                    <span class={["dot", not item.included && "off"]}></span>
                    <span>
                      <b>{item.label}</b><span :if={item.detail} class="sub">{item.detail}</span>
                    </span>
                  </div>
                </div>
              </div>

              <div class="actions">
                <a class="btn sm" href={~p"/app/packages/#{package}/edit"}>Edit</a>
                <button
                  :if={is_nil(package.archived_at)}
                  class="btn sm ghost"
                  phx-click="archive"
                  phx-value-id={package.id}
                  data-confirm={"Archive #{package.name}? Existing quotes are unaffected."}
                >
                  Archive
                </button>
                <button
                  :if={package.archived_at}
                  class="btn sm ghost"
                  phx-click="restore"
                  phx-value-id={package.id}
                >
                  Restore
                </button>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        <.topbar
          title={if @live_action == :new, do: "New package", else: "Edit #{@package.name}"}
          subtitle="What you sell, and what the client gets."
        >
          <:actions>
            <a class="btn" href={~p"/app/packages"}>Cancel</a>
          </:actions>
        </.topbar>

        <div class="formpanel">
          <.form for={@form} phx-change="validate" phx-submit="save" class="form">
            <.section title="What it is">
              <.text_field
                field={@form[:name]}
                label="Name"
                placeholder="Full wedding day"
                required
              />
              <.text_field
                field={@form[:summary]}
                label="One-line summary"
                placeholder="Ten hours, two shooters, 600 edited images"
              />
              <.combo_field
                id="package-shoot-type"
                field={@form[:shoot_type]}
                label="Shoot type"
                options={Enum.map(shoot_types(), &{humanise(&1), &1})}
              />
            </.section>

            <.section title="What it costs">
              <.row layout="two">
                <.field label="Price" hint="Enter it the way you would say it — 4500.">
                  <div class="row amount">
                    <input
                      type="number"
                      step="0.01"
                      min="0"
                      id="package_price_major"
                      name="package[price_major]"
                      value={@price_major}
                      placeholder="4500"
                    />
                    <input
                      type="text"
                      name="package[price_currency]"
                      value={@form[:price_currency].value || @current_scope.currency}
                    />
                  </div>
                </.field>

                <.text_field
                  field={@form[:deposit_percent]}
                  label="Deposit %"
                  type="number"
                  min="0"
                  max="100"
                  hint="Taken at signature."
                />
              </.row>
            </.section>

            <.section title="What the client gets">
              <.row layout="two">
                <.text_field
                  field={@form[:duration_minutes]}
                  label="Duration in minutes"
                  type="number"
                  min="0"
                />
                <.text_field field={@form[:crew_size]} label="Crew" type="number" min="1" />
              </.row>

              <.row layout="two">
                <.text_field
                  field={@form[:delivery_days]}
                  label="Delivery in days"
                  type="number"
                  min="1"
                />
                <.text_field
                  field={@form[:edited_image_count]}
                  label="Edited images"
                  type="number"
                  min="0"
                />
              </.row>

              <.textarea_field field={@form[:description]} label="Description" rows={4} />
            </.section>

            <.section title="Where it appears">
              <.checkbox_field
                field={@form[:public]}
                label="Show on the public booking page"
                checked_default={true}
                hint="Private packages can still be quoted by hand."
              />
            </.section>

            <.form_actions>
              <button type="submit" class="btn primary">
                {if @live_action == :new, do: "Create package", else: "Save changes"}
              </button>
              <a class="btn ghost" href={~p"/app/packages"}>Cancel</a>
            </.form_actions>
          </.form>

          <%= if @live_action == :edit do %>
            <div class="sect" style="margin-top:18px">
              <div class="sect-head with-action">
                <h3>Sample work</h3>
                <span class="spacer"></span>
                <span style="font-size:12px;color:var(--faint)">
                  {length(@package.media)} of {media_limit()} · images to {max_label("image")}, video to {max_label(
                    "video"
                  )}
                </span>
              </div>

              <form
                id="package-media-form"
                phx-submit="upload-media"
                phx-change="validate-media"
                class="gtool"
                style="border:1px solid var(--line);border-radius:var(--r-sm);border-bottom:1px solid var(--line)"
              >
                <label style="font-size:12.5px;color:var(--muted)">Images</label>
                <.live_file_input upload={@uploads.images} />
                <label style="font-size:12.5px;color:var(--muted)">Video</label>
                <.live_file_input upload={@uploads.videos} />
                <span class="spacer"></span>
                <button
                  class="btn sm primary"
                  type="submit"
                  disabled={@uploads.images.entries == [] and @uploads.videos.entries == []}
                >
                  Upload
                </button>
              </form>

              <div
                :for={{upload, kind} <- [{@uploads.images, "image"}, {@uploads.videos, "video"}]}
                :if={upload.entries != [] or upload_errors(upload) != []}
                class="list"
              >
                <div :for={entry <- upload.entries} class="it">
                  <span style="flex:1;min-width:0">
                    <b>{entry.client_name}</b>
                    <span class="sub">
                      {size(entry.client_size)}
                      <%= for error <- upload_errors(upload, entry) do %>
                        · <span class="bad-text">{upload_error(error, kind)}</span>
                      <% end %>
                    </span>
                  </span>
                  <span class="t">{entry.progress}%</span>
                  <button
                    type="button"
                    class="btn sm ghost"
                    phx-click="cancel-upload"
                    phx-value-ref={entry.ref}
                    phx-value-upload={if kind == "video", do: "videos", else: "images"}
                  >
                    Remove
                  </button>
                </div>
                <div :for={error <- upload_errors(upload)} class="it">
                  <span class="dot bad"></span>
                  <span class="bad-text">{upload_error(error, kind)}</span>
                </div>
              </div>

              <div :if={@package.media != []} class="thumbs" style="padding:10px 0">
                <div :for={media <- @package.media} class="th" title={media.filename}>
                  <img
                    :if={media.kind == "image"}
                    src={media_url(media)}
                    alt={media.alt}
                    loading="lazy"
                  />
                  <video :if={media.kind == "video"} src={media_url(media)} muted playsinline />
                  <span class="hb">{size(media.byte_size)}</span>
                  <button
                    type="button"
                    class="btn icon ghost sm"
                    style="position:absolute;right:4px;top:4px;background:var(--panel)"
                    phx-click="remove-media"
                    phx-value-id={media.id}
                    data-confirm={"Remove #{media.filename || "this file"}?"}
                    title="Remove"
                  >
                    ×
                  </button>
                </div>
              </div>

              <p
                :if={@package.media == []}
                style="font-size:12.5px;color:var(--muted);margin:8px 0 0"
              >
                Nothing yet. Sample work is what the package sells with — it shows on the public
                booking page and inside a quote.
              </p>
            </div>
          <% else %>
            <div class="hint" style="margin-top:18px">
              <b>Sample work comes next</b>
              <span style="display:block;margin-top:2px">
                Create the package first, then add up to {media_limit()} images and videos to it.
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
