<Layouts.app flash={@flash}>
  <div class="app">
    <.sidebar current_scope={@current_scope} active={:packages} />

    <div class="main">
      <%= if @live_action == :index do %>
        <.topbar title="Packages" subtitle={"#{length(@packages)} on offer"}>
          <:actions>
            <button
              class="btn sm"
              phx-click="toggle-archived"
              aria-pressed={to_string(@show_archived)}
            >
              {if @show_archived, do: "Hide archived", else: "Show archived"}
            </button>
            <a class="btn primary" href={~p"/app/packages/new"}>+ New package</a>
          </:actions>
        </.topbar>

        <.empty
          :if={@packages == []}
          title="No packages yet"
          body="A package is what you sell: a name, a price, and what is included."
        />

        <div :if={@packages != []} class="pkgs">
          <div :for={package <- @packages} class="pcard">
            <div class="ph-head">
              <h3>{package.name}</h3>
              <span class="spacer"></span>
              <span :if={package.archived_at} class="pill">archived</span>
              <span :if={not package.public and is_nil(package.archived_at)} class="pill">
                private
              </span>
            </div>

            <div style="padding:0 14px 12px">
              <div class="price serif" style="font-size:26px">{price(package)}</div>
              <p style="margin:6px 0 0;color:var(--muted);font-size:13px">
                {package.summary || "No summary yet."}
              </p>

              <div class="kv" style="margin-top:12px">
                <span>Shoot type</span><span>{humanise(package.shoot_type)}</span>
                <span>Duration</span><span>{duration(package)}</span>
                <span>Crew</span><span>{package.crew_size}</span>
                <span>Delivery</span><span>{package.delivery_days} days</span>
                <span>Deposit</span><span>{deposit(package)} ({package.deposit_percent}%)</span>
                <span :if={package.edited_image_count}>Edited images</span>
                <span :if={package.edited_image_count}>{package.edited_image_count}</span>
              </div>

              <div :if={package.items != []} style="margin-top:12px">
                <span class="eyebrow">Included</span>
                <div class="list" style="margin-top:4px">
                  <div :for={item <- package.items} class="it">
                    <span class={["dot", not item.included && "off"]}></span>
                    <span>
                      <b>{item.label}</b><span :if={item.detail} class="sub">{item.detail}</span>
                    </span>
                  </div>
                </div>
              </div>

              <div class="actions">
                <a class="btn sm" href={~p"/app/packages/#{package}/edit"}>Edit</a>
                <button
                  :if={is_nil(package.archived_at)}
                  class="btn sm ghost"
                  phx-click="archive"
                  phx-value-id={package.id}
                  data-confirm={"Archive #{package.name}? Existing quotes are unaffected."}
                >
                  Archive
                </button>
                <button
                  :if={package.archived_at}
                  class="btn sm ghost"
                  phx-click="restore"
                  phx-value-id={package.id}
                >
                  Restore
                </button>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        <.topbar
          title={if @live_action == :new, do: "New package", else: "Edit #{@package.name}"}
          subtitle="What you sell, and what the client gets."
        >
          <:actions>
            <a class="btn" href={~p"/app/packages"}>Cancel</a>
          </:actions>
        </.topbar>

        <div class="formpanel">
          <.form for={@form} phx-change="validate" phx-submit="save" class="form">
            <.section title="What it is">
              <.text_field
                field={@form[:name]}
                label="Name"
                placeholder="Full wedding day"
                required
              />
              <.text_field
                field={@form[:summary]}
                label="One-line summary"
                placeholder="Ten hours, two shooters, 600 edited images"
              />
              <.combo_field
                id="package-shoot-type"
                field={@form[:shoot_type]}
                label="Shoot type"
                options={Enum.map(shoot_types(), &{humanise(&1), &1})}
              />
            </.section>

            <.section title="What it costs">
              <.row layout="two">
                <.field label="Price" hint="Enter it the way you would say it — 4500.">
                  <div class="row amount">
                    <input
                      type="number"
                      step="0.01"
                      min="0"
                      id="package_price_major"
                      name="package[price_major]"
                      value={@price_major}
                      placeholder="4500"
                    />
                    <input
                      type="text"
                      name="package[price_currency]"
                      value={@form[:price_currency].value || @current_scope.currency}
                    />
                  </div>
                </.field>

                <.text_field
                  field={@form[:deposit_percent]}
                  label="Deposit %"
                  type="number"
                  min="0"
                  max="100"
                  hint="Taken at signature."
                />
              </.row>
            </.section>

            <.section title="What the client gets">
              <.row layout="two">
                <.text_field
                  field={@form[:duration_minutes]}
                  label="Duration in minutes"
                  type="number"
                  min="0"
                />
                <.text_field field={@form[:crew_size]} label="Crew" type="number" min="1" />
              </.row>

              <.row layout="two">
                <.text_field
                  field={@form[:delivery_days]}
                  label="Delivery in days"
                  type="number"
                  min="1"
                />
                <.text_field
                  field={@form[:edited_image_count]}
                  label="Edited images"
                  type="number"
                  min="0"
                />
              </.row>

              <.textarea_field field={@form[:description]} label="Description" rows={4} />
            </.section>

            <.section title="Where it appears">
              <.checkbox_field
                field={@form[:public]}
                label="Show on the public booking page"
                checked_default={true}
                hint="Private packages can still be quoted by hand."
              />
            </.section>

            <.form_actions>
              <button type="submit" class="btn primary">
                {if @live_action == :new, do: "Create package", else: "Save changes"}
              </button>
              <a class="btn ghost" href={~p"/app/packages"}>Cancel</a>
            </.form_actions>
          </.form>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
