<%= if @form do %>
  <Layouts.flash_group flash={@flash} />

  <div class="cg">
    <div class="cg-nav">
      <b>{@form.studio.name}</b>
    </div>

    <div style="max-width:560px;margin:0 auto;padding:40px 24px 64px">
      <%= if @sent do %>
        <h1 style="font-family:Fraunces,Georgia,serif;font-weight:400;font-size:32px">
          {@form.success_message || "Thank you"}
        </h1>
        <p style="color:var(--muted);margin-top:10px">
          {@form.studio.name} has your enquiry and will be in touch.
        </p>
      <% else %>
        <h1 style="font-family:Fraunces,Georgia,serif;font-weight:400;font-size:32px">
          {@form.headline || @form.name}
        </h1>
        <p :if={@form.intro} style="color:var(--muted);margin-top:8px">{@form.intro}</p>

        <.form
          for={to_form(%{}, as: :answers)}
          phx-change="validate"
          phx-submit="submit"
          class="form"
          style="margin-top:20px"
        >
          <.field
            :for={field <- @fields}
            label={field["label"]}
            hint={if required?(field), do: "Required"}
          >
            <%= case input_type(field["type"]) do %>
              <% "textarea" -> %>
                <textarea
                  name={"answers[#{field["key"]}]"}
                  rows="4"
                  placeholder={field["placeholder"]}
                  required={required?(field)}
                >{value_for(@answers, field)}</textarea>
              <% "select" -> %>
                <%!-- The one native select left in the product, deliberately.
                Everywhere a studio works is the combobox; this page is filled
                in by a stranger on their phone, where the OS wheel picker beats
                any custom panel, and it still submits if the socket drops. A
                dropdown the client cannot use is a lead that never arrives. --%>
                <select name={"answers[#{field["key"]}]"} required={required?(field)}>
                  <option value="">Choose one</option>
                  <option
                    :for={option <- options_for(field)}
                    value={option}
                    selected={option == value_for(@answers, field)}
                  >
                    {option}
                  </option>
                </select>
              <% "checkbox" -> %>
                <label class="checkfield">
                  <input type="hidden" name={"answers[#{field["key"]}]"} value="" />
                  <input
                    type="checkbox"
                    name={"answers[#{field["key"]}]"}
                    value="yes"
                    checked={value_for(@answers, field) == "yes"}
                  />
                  <span>{field["label"]}</span>
                </label>
              <% type -> %>
                <input
                  type={type}
                  name={"answers[#{field["key"]}]"}
                  value={value_for(@answers, field)}
                  placeholder={field["placeholder"]}
                  required={required?(field)}
                />
            <% end %>

            <span :if={error_for(@errors, field)} class="bad-text" style="font-size:12px">
              This one {error_for(@errors, field)}
            </span>
          </.field>

          <.form_actions>
            <button type="submit" class="btn primary" disabled={@fields == []}>Send it</button>
          </.form_actions>

          <p :if={@fields == []} style="color:var(--muted);font-size:13px;margin:0">
            This form has no questions yet.
          </p>
        </.form>
      <% end %>
    </div>

    <div class="cg-foot">
      <span>{@form.studio.name}</span>
    </div>
  </div>
<% else %>
  <div style="min-height:100vh;display:grid;place-items:center;padding:24px;text-align:center">
    <div style="max-width:420px">
      <h1 style="font-family:Fraunces,Georgia,serif;font-weight:400;font-size:32px">
        This form is not here
      </h1>
      <p style="color:var(--muted);margin-top:10px">
        It may have been taken down. Try the studio's website.
      </p>
    </div>
  </div>
<% end %>
