<div class="authwrap">
  <div class="authcard">
    <a class="brand" href={~p"/"} style="margin-bottom:18px">
      <img src={~p"/images/logo-long.png"} alt="AperDesk" width="132" height="44" />
    </a>

    <h1 class="serif">Start your free trial</h1>
    <p class="sub">Thirty days, no card. Set up in about two minutes.</p>

    <.form :let={f} for={@changeset} action={~p"/sign-up"} as={:registration}>
      <label for="registration_name">Your name</label>
      <input
        type="text"
        id="registration_name"
        name="registration[name]"
        value={Phoenix.HTML.Form.input_value(f, :name)}
        class={AperDeskWeb.AuthHTML.invalid(@changeset, :name)}
        autocomplete="name"
        required
      />
      <AperDeskWeb.AuthHTML.field_errors form={@changeset} field={:name} />

      <label for="registration_studio_name">Studio name</label>
      <input
        type="text"
        id="registration_studio_name"
        name="registration[studio_name]"
        value={Phoenix.HTML.Form.input_value(f, :studio_name)}
        class={AperDeskWeb.AuthHTML.invalid(@changeset, :studio_name)}
        autocomplete="organization"
        required
      />
      <AperDeskWeb.AuthHTML.field_errors form={@changeset} field={:studio_name} />

      <label for="registration_email">Email</label>
      <input
        type="email"
        id="registration_email"
        name="registration[email]"
        value={Phoenix.HTML.Form.input_value(f, :email)}
        class={AperDeskWeb.AuthHTML.invalid(@changeset, :email)}
        autocomplete="email"
        required
      />
      <AperDeskWeb.AuthHTML.field_errors form={@changeset} field={:email} />

      <label for="registration_password">Password</label>
      <input
        type="password"
        id="registration_password"
        name="registration[password]"
        class={AperDeskWeb.AuthHTML.invalid(@changeset, :password)}
        autocomplete="new-password"
        minlength="12"
        required
      />
      <AperDeskWeb.AuthHTML.field_errors form={@changeset} field={:password} />
      <span class="formhint">At least 12 characters. Length beats symbols.</span>

      <button type="submit" class="btn primary">Create my studio</button>
    </.form>

    <p class="alt">Already have an account? <a href={~p"/sign-in"}>Sign in</a></p>
  </div>
</div>
