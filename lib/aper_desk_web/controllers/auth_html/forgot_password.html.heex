<div class="authwrap">
  <div class="authcard">
    <a class="brand" href={~p"/"} style="margin-bottom:18px">
      <img src={~p"/images/logo-long.png"} alt="AperDesk" width="132" height="44" />
    </a>

    <div :if={@sent}>
      <h1 class="serif">Check your email</h1>
      <p class="sub">
        If that address has an AperDesk account, a link to choose a new password is on its way.
        It expires in one hour.
      </p>
      <p class="alt"><a href={~p"/sign-in"}>Back to sign in</a></p>
    </div>

    <div :if={not @sent}>
      <h1 class="serif">Reset your password</h1>
      <p class="sub">We will email you a link to choose a new one.</p>

      <.form :let={_f} for={%{}} action={~p"/forgot-password"} as={:reset}>
        <label for="reset_email">Email</label>
        <input type="email" id="reset_email" name="reset[email]" autocomplete="email" required />
        <button type="submit" class="btn primary">Email me a link</button>
      </.form>

      <p class="alt">Remembered it? <a href={~p"/sign-in"}>Sign in</a></p>
    </div>
  </div>
</div>
